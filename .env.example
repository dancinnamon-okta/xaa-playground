# Okta Configuration
# Replace with your Okta org values

# Your Okta authorization server issuer URL
# For the default Okta authorization server: https://{yourOktaDomain}
# For a custom authorization server: https://{yourOktaDomain}/oauth2/{authServerId}
OKTA_ISSUER=https://your-okta-domain.okta.com/oauth2/default

# The client ID of your Okta application
# Create a new "Web Application" in Okta with the following settings:
# - Sign-in redirect URI: http://localhost:3000/callback
# - Sign-out redirect URI: http://localhost:3000/
# - Grant types: Authorization Code
# - PKCE: Required
# Note: For DPoP support, you may need to enable it in your authorization server settings
OKTA_CLIENT_ID=your-client-id-here

# The client secret for the main Okta application (used for /callback endpoint)
OKTA_CLIENT_SECRET=your-client-secret-here

# The redirect URI (should match what's configured in Okta)
OKTA_REDIRECT_URI=http://localhost:3000/callback

# Session secret - use a strong random string in production
SESSION_SECRET=change-this-to-a-secure-random-string

# Port to run the server on (optional, defaults to 3000)
PORT=3000

# Node environment (optional)
NODE_ENV=development

# XAA Client Configuration (for Cross App Access token exchange)
# This secondary client uses private_key_jwt authentication instead of client_secret
#This needs to be configured in the Directory -> Agents section of Okta!
XAA_CLIENT_ID=your-xaa-client-id-here
XAA_CLIENT_PRIVATE_KEY_FILE=./xaa_private_key.pem
XAA_CLIENT_PRIVATE_KEY_ID=your_kid_here_from_okta